{
  "name": "rpgclubbot_ts",
  "version": "2.5.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "build/RPGClub_GameDB.js",
  "scripts": {
    "build": "tsc",
    "buildDev": "tsc && node --no-warnings=ExperimentalWarning --loader ts-node/esm/transpile-only src/RPGClub_GameDB.ts",
    "docker:build": "docker build -t therpgclub-bot .",
    "docker:up": "docker compose up -d",
    "docker:logs": "docker compose logs -f",
    "dev": "node --no-warnings=ExperimentalWarning --loader ts-node/esm/transpile-only src/RPGClub_GameDB.ts",
    "import:igdb-platforms": "node --no-warnings=ExperimentalWarning --loader ts-node/esm/transpile-only src/scripts/import-igdb-platforms.ts",
    "script:explore-postgres": "node --no-warnings=ExperimentalWarning --loader ts-node/esm/transpile-only src/scripts/explore-postgres.ts",
    "start": "node build/RPGClub_GameDB.js",
    "watch": "nodemon --exec npm run dev --watch src --ext ts",
    "compile": "npx tsc --noEmit",
    "test": "node --no-warnings=ExperimentalWarning --loader ts-node/esm --test src/tests/*.test.ts 2>&1 | tee test-results.txt",
    "lint": "npx eslint",
    "session:start": "node --no-warnings=ExperimentalWarning --loader ts-node/esm scripts/session-start.ts",
    "backup:docker-volumes": "node --no-warnings=ExperimentalWarning --loader ts-node/esm/transpile-only scripts/backup-docker-volumes.ts",
    "remoteBash": "ssh merph518@192.168.50.15"
  },
  "dependencies": {
    "@discordjs/builders": "^1.14.1",
    "@discordx/importer": "^1.3.1",
    "@stylistic/eslint-plugin": "^5.6.1",
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "discord.js": "^14.26.4",
    "discordx": "^11.11.1",
    "exceljs": "^4.4.0",
    "glob": "^11.1.0",
    "googleapis": "^150.0.0",
    "luxon": "^3.7.2",
    "dotenv": "^16.4.5",
    "pg": "^8.21.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.34.5",
    "user-agents": "^1.1.325"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.19.42",
    "@types/pg": "^8.20.0",
    "@types/user-agents": "^1.0.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "jiti": "^2.6.1",
    "nodemon": "^3.1.3",
    "prettier": "^3.3.2",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.46.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
