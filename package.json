{
  "name": "rpgclubbot_ts",
  "version": "2.5.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "build/RPGClub_GameDB.js",
  "scripts": {
    "build": "tsc",
    "buildDev": "tsc && node --no-warnings=ExperimentalWarning --import tsx src/RPGClub_GameDB.ts",
    "docker:build": "docker build -t therpgclub-bot .",
    "docker:up": "docker compose up -d",
    "docker:logs": "docker compose logs -f",
    "dev": "node --no-warnings=ExperimentalWarning --import tsx src/RPGClub_GameDB.ts",
    "import:igdb-platforms": "node --no-warnings=ExperimentalWarning --import tsx src/scripts/import-igdb-platforms.ts",
    "start": "node build/RPGClub_GameDB.js",
    "conductor": "node --no-warnings=ExperimentalWarning --import tsx src/conductor/main.ts",
    "watch": "nodemon --exec npm run dev --watch src --ext ts",
    "compile": "npx tsc --noEmit",
    "test": "node --no-warnings=ExperimentalWarning --import tsx --test src/tests/*.test.ts 2>&1 | tee test-results.txt",
    "lint": "oxlint",
    "session:start": "node --no-warnings=ExperimentalWarning --import tsx scripts/session-start.ts",
    "check:pr-testing": "node --no-warnings=ExperimentalWarning --import tsx scripts/check-pr-testing.ts",
    "test-guild:status": "node --no-warnings=ExperimentalWarning --import tsx scripts/test-guild-status.ts",
    "remoteBash": "ssh -p 2222 merph518@100.120.128.48"
  },
  "dependencies": {
    "@discordjs/builders": "^1.14.1",
    "@discordx/importer": "^1.3.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "discord.js": "^14.27.0",
    "discordx": "^11.13.3",
    "dotenv": "^17.4.2",
    "glob": "^13.0.6",
    "googleapis": "^180.0.0",
    "luxon": "^3.7.2",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.4",
    "user-agents": "^2.1.179",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.20.4",
    "@types/user-agents": "^1.0.4",
    "fflate": "^0.8.3",
    "nodemon": "^3.1.14",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=7.0.0"
  },
  "overrides": {
    "@discordx/importer": {
      "glob": "^13.0.6"
    },
    "gaxios": {
      "rimraf": "^6.1.3"
    }
  }
}
