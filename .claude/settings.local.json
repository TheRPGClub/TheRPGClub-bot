{
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(gh issue edit *)",
      "Bash(npx tsc *)",
      "Bash(Remove-Item \"c:\\\\code\\\\RPGClubBotTs\\\\set-github-key.mjs\", \"c:\\\\code\\\\RPGClubBotTs\\\\test-github-auth.mjs\")",
      "Bash(grep -E '^pg$')",
      "WebFetch(domain:therpgclub.fly.dev)",
      "Bash(curl -s \"https://therpgclub.fly.dev/api/va/games/1\")",
      "Bash(curl -sv \"https://therpgclub.fly.dev/api/va/games/1\")",
      "Bash(curl -s \"https://therpgclub.fly.dev/api/va/games\")",
      "Bash(curl -sv \"https://therpgclub.fly.dev/api/va/games\")",
      "Bash(Select-Object Name, FullName)",
      "Bash(gh issue *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(echo '$CLAUDE_TOOL_INPUT' | jq -r '.file_path // \"\"'); echo \"$file\" | grep -qE '\\.tsx?$' && npx prettier --write \"$file\" 2>/dev/null || true",
            "statusMessage": "Formatting..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(echo '$CLAUDE_TOOL_INPUT' | jq -r '.file_path // \"\"'); echo \"$file\" | grep -qE '\\.tsx?$' && npx tsc --noEmit 2>&1 | tail -5 || true",
            "statusMessage": "Type checking..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(echo '$CLAUDE_TOOL_INPUT' | jq -r '.file_path // \"\"'); base=$(basename \"$file\" .ts); test_file=$(find src/tests -name \"${base}.test.ts\" 2>/dev/null | head -1); [ -n \"$test_file\" ] && node --no-warnings=ExperimentalWarning --loader ts-node/esm --test \"$test_file\" 2>&1 | tail -10 || true",
            "statusMessage": "Running related tests..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK=\"$CLAUDE_PROJECT_DIR/scripts/remind-pr-merge-watch.sh\"; test -x \"$HOOK\" || exit 0; exec \"$HOOK\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"$CLAUDE_PROJECT_DIR/scripts/self_review_gate.py\"; test -f \"$SCRIPT\" || exit 0; exec python3 \"$SCRIPT\" pr-opened",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"$CLAUDE_PROJECT_DIR/scripts/self_review_gate.py\"; test -f \"$SCRIPT\" || exit 0; exec python3 \"$SCRIPT\" review",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "ReportFindings",
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"$CLAUDE_PROJECT_DIR/scripts/self_review_gate.py\"; test -f \"$SCRIPT\" || exit 0; exec python3 \"$SCRIPT\" findings",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "mcp__ccd_sidebar__list_groups",
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"$CLAUDE_PROJECT_DIR/scripts/self_review_gate.py\"; test -f \"$SCRIPT\" || exit 0; exec python3 \"$SCRIPT\" groups",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__ccd_sidebar__move_sessions",
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"$CLAUDE_PROJECT_DIR/scripts/self_review_gate.py\"; test -f \"$SCRIPT\" || exit 0; exec python3 \"$SCRIPT\" sidebar",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"$CLAUDE_PROJECT_DIR/scripts/self_review_gate.py\"; test -f \"$SCRIPT\" || exit 0; exec python3 \"$SCRIPT\" stop",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
