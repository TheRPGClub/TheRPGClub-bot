{
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "general@att-docs": false
  },
  "permissions": {
    "allow": [
      "Bash(gh issue edit *)",
      "Bash(npx tsc *)",
      "Bash(Remove-Item \"c:\\\\code\\\\RPGClubBotTs\\\\set-github-key.mjs\", \"c:\\\\code\\\\RPGClubBotTs\\\\test-github-auth.mjs\")",
      "Bash(grep -E '^pg$')",
      "WebFetch(domain:therpgclub.fly.dev)",
      "Bash(curl -s \"https://therpgclub.fly.dev/api/va/games/1\")",
      "Bash(curl -sv \"https://therpgclub.fly.dev/api/va/games/1\")",
      "Bash(curl -s \"https://therpgclub.fly.dev/api/va/games\")",
      "Bash(curl -sv \"https://therpgclub.fly.dev/api/va/games\")",
      "Bash(Select-Object Name, FullName)",
      "Bash(gh issue *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 90,
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/att-docs/plugins/general/hooks/run.sh\" prTestingGate pr_testing_gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/att-docs/plugins/general/hooks/run.sh\" mergeWatchReminder remind-pr-merge-watch.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/att-docs/plugins/general/hooks/run.sh\" prettierOnSave prettier-on-save.sh",
            "statusMessage": "Formatting..."
          },
          {
            "type": "command",
            "timeout": 180,
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/att-docs/plugins/general/hooks/run.sh\" testOnEdit test-on-edit.sh",
            "statusMessage": "Running related tests..."
          }
        ]
      }
    ]
  }
}
